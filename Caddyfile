{
	# Ports peu courants (valeurs fixées par docker-compose.yml).
	http_port {$HTTP_PORT}
	https_port {$HTTPS_PORT}
	# Les redirections sont gérées à la main plus bas (elles doivent contenir le port).
	auto_https disable_redirects
}

# HTTPS avec un certificat signé par l'autorité locale de Caddy (tls internal).
# L'iPad doit faire confiance à cette autorité : voir LISEZMOI.md.
{$SITE_HOST}:{$HTTPS_PORT} {
	tls internal
	root * /srv
	encode gzip
	# Pas de cache pendant les essais : chaque modification se voit tout de suite.
	header Cache-Control "no-cache"
	file_server
}

# HTTP : sert uniquement le certificat de l'autorité (à installer sur l'iPad),
# et renvoie tout le reste vers HTTPS.
http://{$SITE_HOST}:{$HTTP_PORT} {
	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=root.crt"
		file_server
	}
	handle {
		redir https://{host}:{$HTTPS_PORT}{uri} permanent
	}
}
